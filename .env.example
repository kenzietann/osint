# Copy to .env and fill in. Never commit .env.

# App
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# PostgreSQL
POSTGRES_USER=osint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=osint
DATABASE_URL=postgresql://osint:change-me@localhost:5432/osint

# Redis (job queue)
REDIS_URL=redis://localhost:6379/0

# MinIO (evidence & reports). Password must be at least 8 characters.
MINIO_ROOT_USER=osint
MINIO_ROOT_PASSWORD=change-me-please
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=osint-evidence

# Collectors
GITHUB_TOKEN=

# Default discovery limits
MAX_DEPTH=3
MAX_ENTITIES=500
# MAX_RUNTIME is in seconds
MAX_RUNTIME=600
